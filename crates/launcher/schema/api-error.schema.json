{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The body of every refused API request.",
  "properties": {
    "message": {
      "description": "What was refused and why, for a person to read.",
      "type": "string"
    },
    "version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "message"
  ],
  "title": "ApiError",
  "type": "object"
}
